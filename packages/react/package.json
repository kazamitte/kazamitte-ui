{
  "name": "@kazamitte/kazamitte-ui",
  "version": "0.1.0",
  "description": "Accessible React components built on Ark UI, Tailwind CSS v4 and @kazamitte/design-token.",
  "license": "MIT",
  "author": "kazamitte",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kazamitte/kazamitte-ui.git",
    "directory": "packages/react"
  },
  "keywords": [
    "react",
    "components",
    "ark-ui",
    "tailwindcss",
    "accessibility"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./variants": "./src/variants.ts",
    "./twmerge-config": "./src/twmerge-config.ts",
    "./styles.css": "./src/styles.css",
    "./package.json": "./package.json",
    "./testing/observers": "./src/__tests__/setup/observers.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./variants": {
        "types": "./dist/variants.d.ts",
        "default": "./dist/variants.js"
      },
      "./twmerge-config": {
        "types": "./dist/twmerge-config.d.ts",
        "default": "./dist/twmerge-config.js"
      },
      "./styles.css": "./dist/styles.css",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown && node scripts/check-directives.mjs",
    "lint": "eslint . --cache",
    "lint:full": "eslint .",
    "test": "vitest --project unit --run",
    "test:browser": "vitest --project browser --run",
    "test:coverage": "vitest --project unit --run --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node scripts/prepublish-check.mjs && pnpm build"
  },
  "dependencies": {
    "@ark-ui/react": "^5.37.2",
    "@tanstack/react-table": "^9.2.4",
    "lucide-react": "^1.18.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.4.1",
    "tailwind-variants": "^3.2.2"
  },
  "peerDependencies": {
    "@kazamitte/design-token": "^0.3.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kazamitte/design-token": "^0.3.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.27",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^27.4.0",
    "playwright": "1.63.0",
    "postcss": "^8.4.38",
    "publint": "^0.3.25",
    "react": "^19",
    "react-dom": "^19",
    "tailwindcss": "^4.1.18",
    "tsdown": "^0.23.0",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.70.0",
    "vitest": "4.1.11"
  }
}
