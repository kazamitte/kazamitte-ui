{
  "name": "@kazamitte/kazamitte-ui-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.7.0"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "format": "prettier . --write --cache",
    "format:check": "prettier . --check --cache",
    "lint": "pnpm -r lint",
    "lint:full": "pnpm -r lint:full",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:browser": "pnpm -r test:browser",
    "verify": "pnpm format:check && pnpm lint:full && pnpm typecheck && pnpm test && pnpm build",
    "release": "pnpm -r publish"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.7.4"
  }
}
